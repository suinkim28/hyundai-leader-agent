#!/bin/sh
# Graph 진입점.  어느 OS 에서나 같은 한 줄로 부른다:  bin/graph mail --unread
#
# 왜 셸 스크립트인가
#   Windows 에는 python3 가 없는 경우가 많다. python.org 설치본은
#   python.exe 와 py.exe 만 만든다. 문서마다 OS 별로 다르게 적으면
#   에이전트가 틀린 쪽을 고른다. 그래서 진입점 한 곳에서만 찾는다.
#
#   실제 코드는 bin/graph.py 와 scripts/ 에 있다.
#   cmd, PowerShell 에서 직접 부를 때는 bin\graph.cmd 를 쓴다.
set -u
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# 한국어 Windows 는 콘솔 코드페이지가 cp949 라 Python 기본 출력 인코딩과
# 어긋나 한글이 깨진다 (TODO.txt). PYTHONUTF8=1 로 항상 UTF-8 출력을 강제한다.
export PYTHONUTF8=1

# 순서 주의: py 를 가장 먼저 찾는다.
#
# Windows 10/11 은 실제 Python 이 없어도 python.exe/python3.exe 라는
# 가짜 "App Execution Alias" 를 기본으로 PATH 에 깔아 둔다. 이 가짜는
# 실행하면 "Microsoft Store 에서 설치하십시오" 라고만 하고 끝난다.
# python.org/winget 설치본은 python3 라는 이름을 만들지 않으므로,
# python3 를 먼저 찾으면 항상 이 가짜만 잡혀 진짜 Python 이 있어도
# "못 찾았다"는 결과가 나온다 (2026-09-09 실제로 겪음). py 런처는
# Windows 가 흉내내지 않으므로 먼저 찾아도 안전하다.
for PY in py python3 python; do
  command -v "$PY" >/dev/null 2>&1 || continue
  if [ "$PY" = "py" ]; then
    exec py -3 "$DIR/graph.py" "$@"
  fi
  # python3/python 후보는 가짜 스텁이 아닌지 확인한다: 빈 프로그램을
  # 돌려서 조용히 성공하면 진짜다. 가짜는 인자와 무관하게 안내 문구를
  # 찍고 0이 아닌 코드로 끝난다.
  "$PY" -c "" >/dev/null 2>&1 || continue
  exec "$PY" "$DIR/graph.py" "$@"
done

echo "Python 을 찾지 못했습니다." >&2
echo "  python.org 에서 3.11 이상을 설치하고," >&2
echo "  설치 화면의 'Add python.exe to PATH' 를 체크하십시오." >&2
exit 1
