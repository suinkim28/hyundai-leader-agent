#!/bin/sh
# Graph 진입점.  어느 OS 에서나 같은 한 줄로 부른다:  bin/graph mail --unread
#
# 왜 셸 스크립트인가
#   Windows 에는 python3 가 없는 경우가 많다. python.org 설치본은
#   python.exe 와 py.exe 만 만든다. 문서마다 OS 별로 다르게 적으면
#   에이전트가 틀린 쪽을 고른다. 그래서 진입점 한 곳에서만 찾는다.
#
#   실제 코드는 bin/graph.py 와 scripts/ 에 있다.
#   cmd, PowerShell 에서 직접 부를 때는 bin\graph.cmd 를 쓴다.
set -u
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for PY in python3 py python; do
  command -v "$PY" >/dev/null 2>&1 || continue
  if [ "$PY" = "py" ]; then
    exec py -3 "$DIR/graph.py" "$@"
  fi
  exec "$PY" "$DIR/graph.py" "$@"
done

echo "Python 을 찾지 못했습니다." >&2
echo "  python.org 에서 3.11 이상을 설치하고," >&2
echo "  설치 화면의 'Add python.exe to PATH' 를 체크하십시오." >&2
exit 1
